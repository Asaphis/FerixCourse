# --- Core (local) ---
PORT=4000
RELEASE_ID=local
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Core (production server env — courseapi.ferixas.com) ---
# APP_URL=https://course.ferixas.com
# CORS_ORIGIN=https://course.ferixas.com,https://courseportal.ferixas.com

# --- Postgres (Supabase Postgres for MVP) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/ferixcourse

# --- Backend-owned auth (JWT) ---
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_EXPIRES_DAYS=7

# --- Legacy Supabase (no longer used — kept for reference) ---

# --- Flutterwave (Phase 2, keep empty until configured) ---
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- LiveKit (Phase 3) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Storage R2/S3 (Phase 3) ---
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Email (Phase 5) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@ferixcourse.com
